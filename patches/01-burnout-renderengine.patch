+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#pragma once
+
+#include <SkImage.h>
+#include <SkRect.h>
+#include <SkRuntimeEffect.h>
+#include <SkSurface.h>
+
+#include <mutex>
+#include <string>
+
+namespace android {
+namespace renderengine {
+namespace skia {
+
+struct BurnoutState {
+    // 4 active zones per RGB channel = 12. Bumped from 8 alongside the per-channel
+    // correction model (see app's CorrectionState.MAX_ZONES — kept in sync).
+    static constexpr int kMaxZones = 12;
+    int    zoneCount = 0;
+    SkRect zones[kMaxZones] = {};   // each entry default-init = (0,0,0,0); zoneWeight() returns 0 outside
+    // Per-zone single dim. The shader picks one dominant zone per pixel (highest falloff
+    // weight, tie-break by larger dim) and applies its dim through the channels owned by
+    // that zone (zoneChannels[]); other channels stay on globalDim.
+    float  zoneDims[kMaxZones] = {};
+    // Per-zone RGB has-wear flag (0.f or 1.f per channel). Loaded from each zone's
+    // `channels` JSON array; legacy presets without that field default to {1,1,1}
+    // (matches old global channelHasWear gate). Slots ≥ zoneCount are dead.
+    float  zoneChannels[kMaxZones][3] = {};
+    float  falloffRadiusPx = 0.f;
+    // Per-channel baseline dim (R, G, B). Each channel independent — no cross-channel
+    // gating. Loaded from `global_dim` JSON: array of 3 (new) or scalar broadcast (legacy).
+    float  globalDim[3] = {};
+    float  maxWearR = 0.f;
+    float  maxWearG = 0.f;
+    float  maxWearB = 0.f;
+    SkISize maskSizePx = SkISize::MakeEmpty();
+    // Severity-aware shading (Phase 9). 4 inter-bucket gaps in zones.json's `severity_gaps`
+    // array (sum=100) derive the cumulative wear-fraction lookup. Default 25/25/25/25 → linear.
+    float  sevWearFraction[5] = {0.0f, 0.25f, 0.5f, 0.75f, 1.0f};
+    // Per-zone-per-channel max bucket present (0..4), computed from the loaded mask at
+    // reload time. Combined with sevWearFraction to produce zoneMaxEffWear uniforms.
+    int    maxBucketPresent[kMaxZones][3] = {};
+    float  zoneMaxEffWear[kMaxZones][3] = {};
+};
+
+/**
+ * BurnoutFilter — per-pixel OLED burn-out correction post-pass.
+ *
+ * Modeled on BlurFilter in this directory. Compile SkSL once at construction;
+ * apply per-frame only when enabled and config files are loaded successfully.
+ *
+ * Thread safety: reload() is guarded by mLock; it may be called from the
+ * property-watcher thread. generate() is called on the render thread which holds
+ * mRenderingMutex (SkiaRenderEngine level), and also acquires mLock for the
+ * state snapshot. Never hold both mLock and mRenderingMutex together inside
+ * BurnoutFilter — acquire order is always mRenderingMutex (outer) then mLock.
+ */
+class BurnoutFilter {
+public:
+    BurnoutFilter();
+
+    // Reload mask + zones from /data/burnout/ (runtime) or /system/etc/burnout/
+    // (factory fallback). Returns true iff a usable state was loaded. On false,
+    // mLoaded is set to false and a single warning is logged per attempt.
+    bool reload();
+
+    // True iff the most recent reload() succeeded.
+    bool isLoaded() const;
+
+    // Run the correction post-pass. Reads composedSurface's pixels as a
+    // temporary image, applies the SkSL shader, and draws the corrected
+    // result back into composedSurface's canvas.
+    // Returns true on success; false if skipped (shader not compiled, not loaded).
+    bool generate(SkSurface* composedSurface);
+
+private:
+    bool loadMask(const std::string& path);
+    bool loadZones(const std::string& path);
+
+    sk_sp<SkRuntimeEffect> mEffect;    // compiled once at construction
+    sk_sp<SkImage>         mMask;      // /data/burnout/mask.png
+    BurnoutState            mState;
+    bool                   mLoaded = false;
+    mutable std::mutex     mLock;      // guards mMask, mState, mLoaded
+};
+
+}  // namespace skia
+}  // namespace renderengine
+}  // namespace android
diff --git a/libs/renderengine/skia/filters/burnout_shader.sksl b/libs/renderengine/skia/filters/burnout_shader.sksl
new file mode 100644
index 0000000000..8669ca7c0c
--- /dev/null
+++ b/libs/renderengine/skia/filters/burnout_shader.sksl
@@ -0,0 +1,112 @@
+// SF post-pass burn-out correction. Documentation copy — the runtime uses the
+// embedded literal in BurnoutFilter.cpp (kBurnoutSkSL); this file mirrors it for
+// offline tooling (skslc, syntax-highlight editors) and review.
+//
+// Source of truth for the algorithm: app/src/main/assets/burnout_shader.glsl
+// (the calibrate-mode preview shader).
+// Differences from GLSL:
+//   - SkSL idioms: half/float types, shader.eval() instead of texture()
+//   - composedLayers replaces u_bgColor (we sample the framebuffer being post-processed)
+//   - Drops the playground-only outline / simulate-panel blocks and their uniforms
+//   - Adds framebufferSizePx so coord (pixel space) -> uv (UV space) conversion stays explicit
+//   - No Y-flip: SkSL coord is top-left origin (same as Android Bitmap), unlike GL
+//
+// Channel model: per-zone channel mask + per-channel global baseline. The old
+// "global channelHasWear gate" (a single binary mask derived from max_wear_per_channel)
+// has been removed — sliders are now pure manual controls so a user can intentionally
+// dim a clean channel for color rebalancing. See app's CorrectionState.kt for the
+// matching data model.
+
+uniform shader composedLayers;       // SF framebuffer being post-processed
+uniform shader mask;                  // /data/burnout/mask.png
+uniform float2 framebufferSizePx;     // SF framebuffer dimensions, pixels
+uniform float2 maskSizePx;            // mask dimensions, pixels
+uniform float falloffRadiusPx;        // outward linear-ramp radius around each bbox, mask pixels
+uniform half3 globalDim;              // per-channel baseline (R, G, B). Independent per channel.
+uniform int zoneCount;                // 0..12
+uniform float4 zones[12];             // x0, y0, x1, y1 in UV [0,1]
+uniform half  zoneDims[12];           // per-zone dim
+uniform half3 zoneChannels[12];       // RGB has-wear flag per zone (0 or 1). Default {1,1,1} for legacy.
+uniform half  sevWearFraction[5];     // cumulative bucket-to-wear-fraction lookup [0, c1, c2, c3, 1]
+uniform half3 zoneMaxEffWear[12];     // per-zone-per-channel max effective wear (0..1)
+uniform int correctionOn;             // 0 or 1 — short-circuit when off
+
+half3 srgb2lin(half3 c) { return pow(c, half3(2.2)); }
+half3 lin2srgb(half3 c) { return pow(c, half3(1.0/2.2)); }
+
+// Map a wear value [0..1] to its effective wear via the cumulative sevWearFraction lookup.
+// Uses ternary chain instead of array-indexing-by-runtime-int — SkSL has restrictions on
+// both clamp(int3, ...) and uniform-array indexing by non-constant expressions.
+// Boundaries are midpoints between encoded mask values 0/0.247/0.498/0.749/1.0.
+half lookupSev(half w) {
+    return w < half(0.125) ? sevWearFraction[0]
+         : w < half(0.375) ? sevWearFraction[1]
+         : w < half(0.625) ? sevWearFraction[2]
+         : w < half(0.875) ? sevWearFraction[3]
+         : sevWearFraction[4];
+}
+
+// Falloff weight in [0,1]: 1 inside the bbox, linear ramp to 0 over `radiusPx` outside.
+// uv is in UV space [0,1]; b is the bbox in UV space; radiusPx is in mask-pixel units.
+float zoneWeight(float2 uv, float4 b, float radiusPx) {
+    // Per-axis distance outside the box, in UV.
+    float2 d_uv = max(max(b.xy - uv, uv - b.zw), float2(0.0));
+    if (radiusPx <= 0.0) {
+        // No falloff: hard edge.
+        return (d_uv.x == 0.0 && d_uv.y == 0.0) ? 1.0 : 0.0;
+    }
+    // Convert UV-distance to pixel-distance for true Euclidean falloff.
+    float2 d_px = d_uv * maskSizePx;
+    float dist = length(d_px);
+    return clamp(1.0 - dist / radiusPx, 0.0, 1.0);
+}
+
+half4 main(float2 coord) {
+    half4 src = composedLayers.eval(coord);
+    float2 uv = coord / framebufferSizePx;
+
+    half3 wearRaw = mask.eval(uv * maskSizePx).rgb;
+    half3 lin = srgb2lin(src.rgb);
+    half3 outLin = lin;
+
+    if (correctionOn == 1) {
+        // Per-pixel effective wear via sevWearFraction lookup (see lookupSev() above).
+        half3 effWear = half3(
+            lookupSev(wearRaw.r),
+            lookupSev(wearRaw.g),
+            lookupSev(wearRaw.b)
+        );
+
+        // Per-channel max-of-lerp: each output channel picks the strongest dim contribution
+        // among same-channel zones. globalDim is the floor (pixels outside any same-channel
+        // zone). C0 continuous in falloff overlap regions where two same-channel zones' tails
+        // meet — natural smoothing without dim-tie-break artifacts.
+        half3 zoneDimV = globalDim;
+        half3 zoneMaxEff = half3(0.0);
+        for (int i = 0; i < 12; i++) {
+            if (i >= zoneCount) { break; }
+            float w = zoneWeight(uv, zones[i], falloffRadiusPx);
+            for (int c = 0; c < 3; c++) {
+                if (zoneChannels[i][c] < half(0.5)) { continue; }
+                half candidate = mix(globalDim[c], zoneDims[i], half(w));
+                if (candidate > zoneDimV[c]) {
+                    zoneDimV[c] = candidate;
+                    zoneMaxEff[c] = zoneMaxEffWear[i][c];
+                }
+            }
+        }
+
+        // Severity factor: 1.0 outside any zone, 0.0 at zone-max-wear, linear in between.
+        // Channels with zoneMaxEff == 0 (no same-channel zone reaches this pixel) fall back to 1.
+        half3 factor = clamp(
+            (zoneMaxEff - effWear) / max(zoneMaxEff, half3(1e-6)),
+            half3(0.0), half3(1.0));
+        factor = mix(half3(1.0), factor, step(half3(1e-6), zoneMaxEff));
+
+        half3 dimV = clamp(zoneDimV * factor, half3(0.0), half3(0.99));
+        outLin = lin * (half3(1.0) - dimV);
+    }
+
+    outLin = clamp(outLin, half3(0.0), half3(1.0));
+    return half4(lin2srgb(outLin), src.a);
+}
diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 0ab1a9b812..106fab3fd2 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -3460,6 +3460,22 @@ void SurfaceFlinger::setForcedClientCompositionLayerStacks(
         forceAllDisplaysToClientComposition = true;
     }
 
+    // Burn-out correction requires GPU composition on every frame so the post-pass
+    // shader is applied consistently. Mirror mDebugDisableHWC: if the master prop
+    // is "1" AND not suspended, force CLIENT composition for all layer stacks,
+    // then let SkiaRenderEngine::drawLayersInternal() apply the BurnoutFilter post-pass.
+    // Default-on semantics: only an explicit "0" disables. Unset / "1" / anything else = on.
+    // Suspend semantics: only an explicit "1" suspends. Unset / "0" / anything else = active.
+    // The Burn-out system app sets sys.burnout.suspend=1 while foreground so its tuning
+    // canvas isn't double-corrected.
+    static base::CachedProperty sBurnoutEnabled("persist.sys.burnout.enabled");
+    static base::CachedProperty sBurnoutSuspend("sys.burnout.suspend");
+    if (!forceAllDisplaysToClientComposition &&
+        sBurnoutEnabled.Get() != "0"sv &&
+        sBurnoutSuspend.Get() != "1"sv) {
+        forceAllDisplaysToClientComposition = true;
+    }
+
     if (mDebugFlashDelay != 0) {
         forceAllDisplaysToClientComposition = true;
         refreshArgs.devOptFlashDirtyRegionsDelay = std::chrono::milliseconds(mDebugFlashDelay);

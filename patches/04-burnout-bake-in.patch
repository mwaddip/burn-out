diff --git a/burnout/burnout.mk b/burnout/burnout.mk
new file mode 100644
index 00000000..081d1c06
--- /dev/null
+++ b/burnout/burnout.mk
@@ -0,0 +1,33 @@
+# Burn-out compensation — factory bake-in target (multi-device template).
+#
+# Include this from your device's makefile after setting BURNOUT_FB_WIDTH and
+# BURNOUT_FB_HEIGHT to your device's framebuffer dimensions. Example:
+#
+#   # In device/<vendor>/<device>/device.mk:
+#   BURNOUT_FB_WIDTH  := 1440
+#   BURNOUT_FB_HEIGHT := 3216
+#   include vendor/lineage/burnout/burnout.mk
+#
+# Factory assets in factory/mask.png + factory/zones.json must match
+# BURNOUT_FB_WIDTH x BURNOUT_FB_HEIGHT. The bundled defaults are sized
+# 1440x3216 (OnePlus 12). For other devices, regenerate before building:
+#
+#   bash <burn-out repo>/scripts/generate-blank-burnout-assets.sh \
+#     <fb_w> <fb_h> vendor/lineage/burnout/factory/
+
+ifndef BURNOUT_FB_WIDTH
+$(error BURNOUT_FB_WIDTH not set; set it to your device's framebuffer width before including burnout.mk)
+endif
+ifndef BURNOUT_FB_HEIGHT
+$(error BURNOUT_FB_HEIGHT not set; set it to your device's framebuffer height before including burnout.mk)
+endif
+
+# Path is hardcoded because $(call my-dir) returns empty under Soong product-config
+# evaluation when this file is consumed via plain `include` from a device.mk. This
+# template always lives at vendor/lineage/burnout/, so hardcoding is safe.
+PRODUCT_COPY_FILES += \
+    vendor/lineage/burnout/factory/mask.png:system/etc/burnout/mask.png \
+    vendor/lineage/burnout/factory/zones.json:system/etc/burnout/zones.json
+
+# Bundle the Burn-out system app (platform-signed, /system/app/Burnout/).
+PRODUCT_PACKAGES += Burnout

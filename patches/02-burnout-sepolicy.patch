diff --git a/private/seapp_contexts b/private/seapp_contexts
index a6e829dd2..6a42053db 100644
--- a/private/seapp_contexts
+++ b/private/seapp_contexts
@@ -214,3 +214,9 @@ user=_app fromRunAs=true domain=runas_app levelFrom=user
 user=_app isPrivApp=true name=com.android.virtualization.terminal domain=vmlauncher_app type=privapp_data_file levelFrom=all
 user=_app isPrivApp=true name=com.android.virtualization.terminal:* domain=vmlauncher_app type=privapp_data_file levelFrom=all
 user=_app isPrivApp=true name=com.google.android.adservices.api domain=adservices type=privapp_data_file levelFrom=all
+
+# Burn-out compensation system app (Phase 6): platform-signed app.burnout running
+# as system UID gets routed to the burnout_app domain with private burnout_app_data_file
+# data type. Without this entry, the app would fall into system_app (since user=system
+# + seinfo=platform matches that earlier rule), which lacks the burnout-specific allows.
+user=system seinfo=platform name=app.burnout domain=burnout_app type=burnout_app_data_file

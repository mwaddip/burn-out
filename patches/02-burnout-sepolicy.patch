diff --git a/private/burnout_app.te b/private/burnout_app.te
new file mode 100644
index 000000000..e8d328aa4
--- /dev/null
+++ b/private/burnout_app.te
@@ -0,0 +1,31 @@
+# Burn-out compensation system app — operative domain (Phase 6).
+#
+# This domain runs the platform-signed Burn-out system app (package app.burnout)
+# bundled at /system/app/Burnout/ on burn-out-enabled LineageOS ROMs. The app
+# uses sharedUserId="android.uid.system" and the platform certificate, so
+# seapp_contexts routes user=system + seinfo=platform + name=app.burnout into
+# this domain.
+#
+# Capabilities granted:
+#   - set_prop on burnout_prop (persist.sys.burnout.*, sys.burnout.*) so the app
+#     can toggle correction, signal reload, and set the suspend prop without a
+#     Runtime.exec("su", ...) shell-out.
+#   - read+write on /data/burnout/{mask.png,zones.json} (burnout_data_file) so
+#     Calibrate Save commits live without root.
+#   - read+write on the app's own private data dir (burnout_app_data_file).
+
+type burnout_app, domain, coredomain;
+
+app_domain(burnout_app);
+
+# Set burn-out sysprops: persist.sys.burnout.enabled, sys.burnout.reload, sys.burnout.suspend.
+set_prop(burnout_app, burnout_prop)
+
+# Read+write /data/burnout/{mask.png,zones.json} for Calibrate Save.
+allow burnout_app burnout_data_file:dir { create_dir_perms relabelfrom };
+allow burnout_app burnout_data_file:file { create_file_perms relabelto };
+
+# App's private data dir (under /data/data/app.burnout/, but typed for completeness;
+# Android's package installer creates this with the seapp_contexts type).
+allow burnout_app burnout_app_data_file:dir create_dir_perms;
+allow burnout_app burnout_app_data_file:file create_file_perms;
diff --git a/private/file.te b/private/file.te
index b832da44c..c6f9df261 100644
--- a/private/file.te
+++ b/private/file.te
@@ -283,3 +283,12 @@ until_board_api(202604, `type sysfs_typec, fs_type, sysfs_type;')
 until_board_api(202604, `type sysfs_usb_pd, fs_type, sysfs_type;')
 
 type zygote_next_socket, file_type, coredomain_socket;
+
+# /data/burnout — burn-out compensation mask + zones config
+type burnout_data_file, file_type, data_file_type, core_data_file_type;
+
+# /data/data/app.burnout — Burn-out system app's private data (Phase 6). Same
+# attribute set as system_app_data_file (in public/) because the app shares
+# the system UID via sharedUserId="android.uid.system". Kept private to avoid
+# touching the frozen 202504 public API surface.
+type burnout_app_data_file, file_type, data_file_type, core_data_file_type, app_data_file_type, mlstrustedobject;

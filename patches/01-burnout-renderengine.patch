+
+namespace android {
+namespace renderengine {
+namespace skia {
+
+namespace {
+
+// SkSL source — embedded as a string literal. Content stays in sync with
+// libs/renderengine/skia/filters/burnout_shader.sksl (the .sksl file is for
+// documentation and offline tooling; only this embedded copy is used at runtime).
+constexpr char kBurnoutSkSL[] = R"SkSL(
+uniform shader composedLayers;
+uniform shader mask;
+uniform float2 framebufferSizePx;
+uniform float2 maskSizePx;
+uniform float falloffRadiusPx;
+uniform half3 globalDim;             // per-channel baseline (R, G, B)
+uniform int zoneCount;
+uniform float4 zones[12];
+uniform half  zoneDims[12];           // per-zone dim
+uniform half3 zoneChannels[12];      // RGB has-wear flag per zone (0 or 1)
+uniform half sevWearFraction[5];     // cumulative bucket-to-wear-fraction lookup
+uniform half3 zoneMaxEffWear[12];    // per-zone-per-channel max effective wear (0..1)
+uniform int correctionOn;
+
+half3 srgb2lin(half3 c) { return pow(c, half3(2.2)); }
+half3 lin2srgb(half3 c) { return pow(c, half3(1.0/2.2)); }
+
+// Map a wear value [0..1] to its effective wear via the cumulative sevWearFraction lookup.
+// Uses ternary chain instead of array-indexing-by-runtime-int — SkSL has restrictions on
+// both clamp(int3, ...) and uniform-array indexing by non-constant expressions.
+// Boundaries are midpoints between encoded mask values 0/0.247/0.498/0.749/1.0.
+half lookupSev(half w) {
+    return w < half(0.125) ? sevWearFraction[0]
+         : w < half(0.375) ? sevWearFraction[1]
+         : w < half(0.625) ? sevWearFraction[2]
+         : w < half(0.875) ? sevWearFraction[3]
+         : sevWearFraction[4];
+}
+
+float zoneWeight(float2 uv, float4 b, float radiusPx) {
+    float2 d_uv = max(max(b.xy - uv, uv - b.zw), float2(0.0));
+    if (radiusPx <= 0.0) {
+        return (d_uv.x == 0.0 && d_uv.y == 0.0) ? 1.0 : 0.0;
+    }
+    float2 d_px = d_uv * maskSizePx;
+    float dist = length(d_px);
+    return clamp(1.0 - dist / radiusPx, 0.0, 1.0);
+}
+
+half4 main(float2 coord) {
+    half4 src = composedLayers.eval(coord);
+    float2 uv = coord / framebufferSizePx;
+    half3 wearRaw = mask.eval(uv * maskSizePx).rgb;
+    half3 lin = srgb2lin(src.rgb);
+    half3 outLin = lin;
+    if (correctionOn == 1) {
+        // Per-pixel effective wear via sevWearFraction lookup (see lookupSev() above).
+        half3 effWear = half3(
+            lookupSev(wearRaw.r),
+            lookupSev(wearRaw.g),
+            lookupSev(wearRaw.b)
+        );
+
+        // Per-channel max-of-lerp: each output channel picks the strongest dim contribution
+        // among same-channel zones. globalDim is the floor (pixels outside any same-channel
+        // zone). C0 continuous in falloff overlap regions where two same-channel zones' tails
+        // meet — natural smoothing without dim-tie-break artifacts.
+        half3 zoneDimV = globalDim;
+        half3 zoneMaxEff = half3(0.0);
+        for (int i = 0; i < 12; i++) {
+            if (i >= zoneCount) { break; }
+            float w = zoneWeight(uv, zones[i], falloffRadiusPx);
+            for (int c = 0; c < 3; c++) {
+                if (zoneChannels[i][c] < half(0.5)) { continue; }
+                half candidate = mix(globalDim[c], zoneDims[i], half(w));
+                if (candidate > zoneDimV[c]) {
+                    zoneDimV[c] = candidate;
+                    zoneMaxEff[c] = zoneMaxEffWear[i][c];
+                }
+            }
+        }
+
+        // Severity factor: 1.0 outside any zone, 0.0 at zone-max-wear, linear in between.
+        // Channels with zoneMaxEff == 0 (no same-channel zone reaches this pixel) fall back to 1.
+        half3 factor = clamp(
+            (zoneMaxEff - effWear) / max(zoneMaxEff, half3(1e-6)),
+            half3(0.0), half3(1.0));
+        factor = mix(half3(1.0), factor, step(half3(1e-6), zoneMaxEff));
+
+        half3 dimV = clamp(zoneDimV * factor, half3(0.0), half3(0.99));
+        outLin = lin * (half3(1.0) - dimV);
+    }
+    outLin = clamp(outLin, half3(0.0), half3(1.0));
+    return half4(lin2srgb(outLin), src.a);
+}
+)SkSL";
+
+// Primary config (writable, user-tunable via push-burnout-config.sh).
+constexpr char kMaskPathRuntime[]  = "/data/burnout/mask.png";
+constexpr char kZonesPathRuntime[] = "/data/burnout/zones.json";
+
+// Factory fallback (baked into the system image).
+constexpr char kMaskPathFallback[]  = "/system/etc/burnout/mask.png";
+constexpr char kZonesPathFallback[] = "/system/etc/burnout/zones.json";
+
+} // namespace
+
+BurnoutFilter::BurnoutFilter() {
+    auto [effect, errorText] = SkRuntimeEffect::MakeForShader(SkString(kBurnoutSkSL));
+    if (!effect) {
+        ALOGE("BurnoutFilter: SkSL compile failed: %s", errorText.c_str());
+        return;
+    }
+    mEffect = effect;
+    ALOGI("BurnoutFilter: SkSL compiled successfully");
+}
+
+bool BurnoutFilter::isLoaded() const {
+    std::lock_guard<std::mutex> lock(mLock);
+    return mLoaded;
+}
+
+bool BurnoutFilter::reload() {
+    std::lock_guard<std::mutex> lock(mLock);
+    mLoaded = false;
+
+    if (!mEffect) {
+        ALOGW("BurnoutFilter::reload: SkSL not compiled, skipping");
+        return false;
+    }
+
+    // Mask: try /data/burnout/ first, fall back to /system/etc/burnout/.
+    const char* maskSrc = kMaskPathRuntime;
+    if (!loadMask(kMaskPathRuntime)) {
+        maskSrc = kMaskPathFallback;
+        if (!loadMask(kMaskPathFallback)) {
+            return false;
+        }
+    }
+
+    // Zones: independent fallback — a partial /data/burnout/ (only mask.png) still
+    // gets the factory zones.json.
+    const char* zonesSrc = kZonesPathRuntime;
+    if (!loadZones(kZonesPathRuntime)) {
+        zonesSrc = kZonesPathFallback;
+        if (!loadZones(kZonesPathFallback)) {
+            return false;
+        }
+    }
+
+    ALOGI("BurnoutFilter: loaded mask %dx%d from %s, zones from %s, "
+          "%d zone(s), globalDim=[%.3f, %.3f, %.3f], falloff=%.1fpx",
+          mState.maskSizePx.width(), mState.maskSizePx.height(), maskSrc, zonesSrc,
+          mState.zoneCount,
+          mState.globalDim[0], mState.globalDim[1], mState.globalDim[2],
+          mState.falloffRadiusPx);
+    mLoaded = true;
+    return true;
+}
+
+bool BurnoutFilter::loadMask(const std::string& path) {
+    std::string bytes;
+    if (!android::base::ReadFileToString(path, &bytes)) {
+        ALOGW("BurnoutFilter: cannot read %s", path.c_str());
+        return false;
+    }
+
+    // libskia_renderengine is built without image codecs, so SkImages::DeferredFromEncodedData
+    // returns nullptr for PNGs. Decode via libpng's simplified API (no setjmp/longjmp dance,
+    // returns error codes through image.message) and hand the raw RGBA8 buffer to Skia.
+    png_image image;
+    std::memset(&image, 0, sizeof(image));
+    image.version = PNG_IMAGE_VERSION;
+    if (!png_image_begin_read_from_memory(&image, bytes.data(), bytes.size())) {
+        ALOGW("BurnoutFilter: cannot decode %s: %s", path.c_str(), image.message);
+        return false;
+    }
+    image.format = PNG_FORMAT_RGBA;
+    const int width = static_cast<int>(image.width);
+    const int height = static_cast<int>(image.height);
+    const size_t pixelBytes = PNG_IMAGE_SIZE(image);
+    auto pixels = std::make_unique<uint8_t[]>(pixelBytes);
+    if (!png_image_finish_read(&image, /*background*/nullptr, pixels.get(),
+                               /*row_stride*/0, /*colormap*/nullptr)) {
+        ALOGW("BurnoutFilter: cannot decode %s: %s", path.c_str(), image.message);
+        png_image_free(&image);
+        return false;
+    }
+
+    SkImageInfo skInfo = SkImageInfo::Make(width, height,
+                                           kRGBA_8888_SkColorType,
+                                           kUnpremul_SkAlphaType);
+    sk_sp<SkData> data = SkData::MakeWithCopy(pixels.get(), pixelBytes);
+    sk_sp<SkImage> img = SkImages::RasterFromData(skInfo, std::move(data),
+                                                  static_cast<size_t>(width) * 4);
+    if (!img) {
+        ALOGW("BurnoutFilter: SkImages::RasterFromData returned null for %s", path.c_str());
+        return false;
+    }
+    mMask = img;
+    mState.maskSizePx = SkISize::Make(width, height);
+    return true;
+}
+
+bool BurnoutFilter::loadZones(const std::string& path) {
+    std::string text;
+    if (!android::base::ReadFileToString(path, &text)) {
+        ALOGW("BurnoutFilter: cannot read %s", path.c_str());
+        return false;
+    }
+
+    Json::Value root;
+    Json::Reader reader;
+    if (!reader.parse(text, root, /*collectComments=*/false)) {
+        ALOGW("BurnoutFilter: cannot parse %s: %s", path.c_str(),
+              reader.getFormattedErrorMessages().c_str());
+        return false;
+    }
+
+    if (!root.isMember("falloff_radius_px") || !root.isMember("global_dim") ||
+        !root.isMember("zones") || !root.isMember("max_wear_per_channel")) {
+        ALOGW("BurnoutFilter: %s missing required fields", path.c_str());
+        return false;
+    }
+
+    mState.falloffRadiusPx = root["falloff_radius_px"].asFloat();
+
+    // global_dim: new format is a 3-element array (R, G, B); legacy presets store a scalar
+    // which we broadcast to all three channels.
+    const Json::Value& gd = root["global_dim"];
+    if (gd.isArray() && gd.size() == 3u) {
+        mState.globalDim[0] = gd[0u].asFloat();
+        mState.globalDim[1] = gd[1u].asFloat();
+        mState.globalDim[2] = gd[2u].asFloat();
+    } else {
+        const float scalar = gd.asFloat();
+        mState.globalDim[0] = mState.globalDim[1] = mState.globalDim[2] = scalar;
+    }
+
+    const Json::Value& mw = root["max_wear_per_channel"];
+    mState.maxWearR = mw.get("r", 0.0).asFloat();
+    mState.maxWearG = mw.get("g", 0.0).asFloat();
+    mState.maxWearB = mw.get("b", 0.0).asFloat();
+
+    // severity_gaps: optional 4-element array, sum=100. Missing/invalid → keep linear default.
+    const Json::Value& sg = root["severity_gaps"];
+    if (sg.isArray() && sg.size() == 4u) {
+        int gaps[4];
+        bool ok = true;
+        int sum = 0;
+        for (int i = 0; i < 4; ++i) {
+            gaps[i] = sg[static_cast<unsigned>(i)].asInt();
+            if (gaps[i] < 0 || gaps[i] > 100) ok = false;
+            sum += gaps[i];
+        }
+        if (ok && sum == 100) {
+            int cum = 0;
+            mState.sevWearFraction[0] = 0.0f;
+            for (int i = 0; i < 4; ++i) {
+                cum += gaps[i];
+                mState.sevWearFraction[i + 1] = static_cast<float>(cum) / 100.0f;
+            }
+            mState.sevWearFraction[4] = 1.0f;  // pin against rounding error
+        }
+    }
+
+    const Json::Value& zones = root["zones"];
+    if (!zones.isArray()) {
+        ALOGW("BurnoutFilter: %s zones field is not an array", path.c_str());
+        return false;
+    }
+
+    const float w = static_cast<float>(mState.maskSizePx.width());
+    const float h = static_cast<float>(mState.maskSizePx.height());
+    if (w <= 0.f || h <= 0.f) {
+        ALOGW("BurnoutFilter: mask must be loaded before zones");
+        return false;
+    }
+
+    mState.zoneCount = std::min(BurnoutState::kMaxZones, static_cast<int>(zones.size()));
+
+    auto loadZone = [&](const Json::Value& z, SkRect* outBbox, float* outDim, float* outChannels) {
+        const float x0 = z["x0"].asFloat();
+        const float y0 = z["y0"].asFloat();
+        const float x1 = z["x1"].asFloat();
+        const float y1 = z["y1"].asFloat();
+        *outBbox = SkRect::MakeLTRB(x0 / w, y0 / h, x1 / w, y1 / h);  // pixel → UV
+        *outDim = z["dim"].asFloat();
+        // channels: 3-element array of 0/1. Legacy presets without the field default
+        // to {1, 1, 1} so all-channels-wearing matches the old global gate.
+        const Json::Value& ch = z["channels"];
+        if (ch.isArray() && ch.size() == 3u) {
+            outChannels[0] = ch[0u].asFloat();
+            outChannels[1] = ch[1u].asFloat();
+            outChannels[2] = ch[2u].asFloat();
+        } else {
+            outChannels[0] = outChannels[1] = outChannels[2] = 1.f;
+        }
+    };
+
+    for (int i = 0; i < mState.zoneCount; ++i) {
+        loadZone(zones[i], &mState.zones[i], &mState.zoneDims[i], mState.zoneChannels[i]);
+    }
+
+    // Compute per-zone-per-channel max bucket present + zoneMaxEffWear lookup.
+    // Bucket boundaries midway between encoded mask values 63/127/191/255.
+    auto bucketOf = [](int v) -> int {
+        if (v <= 0)   return 0;
+        if (v < 95)   return 1;
+        if (v < 159)  return 2;
+        if (v < 223)  return 3;
+        return 4;
+    };
+    const int maskW = mState.maskSizePx.width();
+    const int maskH = mState.maskSizePx.height();
+    for (int zi = 0; zi < BurnoutState::kMaxZones; ++zi) {
+        // default to no-wear for unused slots; shader's step(1e-6) gives factor=1 fallback
+        for (int c = 0; c < 3; ++c) {
+            mState.maxBucketPresent[zi][c] = 0;
+            mState.zoneMaxEffWear[zi][c] = 0.0f;
+        }
+    }
+    for (int zi = 0; zi < mState.zoneCount; ++zi) {
+        const SkRect& bbox = mState.zones[zi];
+        const int x0 = std::clamp(static_cast<int>(bbox.left()  * maskW), 0, maskW - 1);
+        const int y0 = std::clamp(static_cast<int>(bbox.top()   * maskH), 0, maskH - 1);
+        const int x1 = std::clamp(static_cast<int>(bbox.right() * maskW), 0, maskW - 1);
+        const int y1 = std::clamp(static_cast<int>(bbox.bottom()* maskH), 0, maskH - 1);
+        const int rw = x1 - x0 + 1;
+        const int rh = y1 - y0 + 1;
+        if (rw <= 0 || rh <= 0) continue;
+
+        SkImageInfo info = SkImageInfo::Make(rw, rh, kRGBA_8888_SkColorType,
+                                             kUnpremul_SkAlphaType);
+        auto buf = std::make_unique<uint8_t[]>(static_cast<size_t>(rw) * rh * 4);
+        if (!mMask->readPixels(/*context*/nullptr, info, buf.get(),
+                               static_cast<size_t>(rw) * 4, x0, y0)) {
+            ALOGW("BurnoutFilter: zone %d readPixels failed; using factor=1 fallback", zi);
+            continue;
+        }
+        int maxR = 0, maxG = 0, maxB = 0;
+        for (int i = 0; i < rw * rh; ++i) {
+            const int r = buf[i * 4 + 0];
+            const int g = buf[i * 4 + 1];
+            const int b = buf[i * 4 + 2];
+            if (r > maxR) maxR = r;
+            if (g > maxG) maxG = g;
+            if (b > maxB) maxB = b;
+        }
+        mState.maxBucketPresent[zi][0] = bucketOf(maxR);
+        mState.maxBucketPresent[zi][1] = bucketOf(maxG);
+        mState.maxBucketPresent[zi][2] = bucketOf(maxB);
+        for (int c = 0; c < 3; ++c) {
+            mState.zoneMaxEffWear[zi][c] =
+                mState.sevWearFraction[mState.maxBucketPresent[zi][c]];
+        }
+    }
+
+    return true;
+}
+
+bool BurnoutFilter::generate(SkSurface* composedSurface) {
+    using namespace std::string_view_literals;
+    std::lock_guard<std::mutex> lock(mLock);
+
+    if (!mLoaded || !mEffect || !composedSurface) {
+        return false;
+    }
+
+    static android::base::CachedProperty sBurnoutEnabled("persist.sys.burnout.enabled");
+    static android::base::CachedProperty sBurnoutSuspend("sys.burnout.suspend");
+    // Default-on semantics: only an explicit "0" disables. Unset / "1" / anything else = on.
+    // Suspend semantics: only an explicit "1" suspends. Unset / "0" / anything else = active.
+    const bool correctionOn = (sBurnoutEnabled.Get() != "0"sv) && (sBurnoutSuspend.Get() != "1"sv);
+
+    // Snapshot the current framebuffer contents as an image to use as shader input.
+    sk_sp<SkImage> input = composedSurface->makeImageSnapshot();
+    if (!input) {
+        ALOGW("BurnoutFilter::generate: makeImageSnapshot returned null");
+        return false;
+    }
+
+    SkRuntimeShaderBuilder builder(mEffect);
+    builder.child("composedLayers") = input->makeShader(SkSamplingOptions());
+    builder.child("mask") =
+        mMask->makeShader(SkTileMode::kClamp, SkTileMode::kClamp,
+                          SkSamplingOptions(SkFilterMode::kLinear));
+
+    const SkISize fbSize = input->dimensions();
+    builder.uniform("framebufferSizePx") =
+        SkV2{static_cast<float>(fbSize.width()), static_cast<float>(fbSize.height())};
+    builder.uniform("maskSizePx") =
+        SkV2{static_cast<float>(mState.maskSizePx.width()),
+             static_cast<float>(mState.maskSizePx.height())};
+    builder.uniform("falloffRadiusPx") = mState.falloffRadiusPx;
+    builder.uniform("globalDim")       = SkV3{mState.globalDim[0],
+                                              mState.globalDim[1],
+                                              mState.globalDim[2]};
+    builder.uniform("zoneCount")       = mState.zoneCount;
+    SkV4 zoneUniforms[BurnoutState::kMaxZones];
+    SkV3 zoneChannelsUniforms[BurnoutState::kMaxZones];
+    for (int i = 0; i < BurnoutState::kMaxZones; ++i) {
+        zoneUniforms[i] = SkV4{mState.zones[i].fLeft,  mState.zones[i].fTop,
+                                mState.zones[i].fRight, mState.zones[i].fBottom};
+        zoneChannelsUniforms[i] = SkV3{mState.zoneChannels[i][0],
+                                        mState.zoneChannels[i][1],
+                                        mState.zoneChannels[i][2]};
+    }
+    builder.uniform("zones").set(zoneUniforms, BurnoutState::kMaxZones);
+    builder.uniform("zoneDims").set(mState.zoneDims, BurnoutState::kMaxZones);
+    builder.uniform("zoneChannels").set(zoneChannelsUniforms, BurnoutState::kMaxZones);
+
+    // Severity-aware uniforms (Phase 9). sevWearFraction maps bucket → wear fraction;
+    // zoneMaxEffWear is the per-zone-per-channel ceiling derived at mask-load time.
+    builder.uniform("sevWearFraction").set(mState.sevWearFraction, 5);
+    SkV3 zoneMaxEffUniforms[BurnoutState::kMaxZones];
+    for (int i = 0; i < BurnoutState::kMaxZones; ++i) {
+        zoneMaxEffUniforms[i] = SkV3{mState.zoneMaxEffWear[i][0],
+                                     mState.zoneMaxEffWear[i][1],
+                                     mState.zoneMaxEffWear[i][2]};
+    }
+    builder.uniform("zoneMaxEffWear").set(zoneMaxEffUniforms, BurnoutState::kMaxZones);
+
+    builder.uniform("correctionOn") = correctionOn ? 1 : 0;
+
+    auto shader = builder.makeShader();
+    if (!shader) {
+        ALOGW("BurnoutFilter::generate: makeShader returned null");
+        return false;
+    }
+
+    // Draw the corrected output back into the same surface's canvas.
+    // The surface IS the output framebuffer (dstSurface in drawLayersInternal).
+    SkPaint paint;
+    paint.setShader(std::move(shader));
+    paint.setBlendMode(SkBlendMode::kSrc);
+    composedSurface->getCanvas()->drawPaint(paint);
+    return true;
+}
+
+}  // namespace skia
+}  // namespace renderengine
+}  // namespace android

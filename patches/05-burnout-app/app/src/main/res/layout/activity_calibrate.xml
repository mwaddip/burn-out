<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <android.opengl.GLSurfaceView
        android:id="@+id/gl_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <app.burnout.calibrate.CornerOverlayView
        android:id="@+id/corner_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <TextView
        android:id="@+id/add_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:padding="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:background="#C0CC8800"
        android:visibility="gone"
        android:text="@string/calibrate_add_banner" />

    <TextView
        android:id="@+id/status_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="12dp"
        android:padding="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:background="#80000000"
        android:fontFamily="monospace"
        android:text="" />

    <LinearLayout
        android:id="@+id/controls_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#A0000000">

        <TextView
            android:id="@+id/controls_drag_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFCCCCCC"
            android:text="@string/drag_handle" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BG: white"/>
            <Button android:id="@+id/btn_zone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibrate_zone"/>
            <Button android:id="@+id/btn_ab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ab_hide_hold"/>
        </LinearLayout>

        <TextView android:id="@+id/lbl_dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:text="zone dim"/>
        <SeekBar android:id="@+id/seek_dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView android:id="@+id/lbl_radius"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:text="falloff radius: 0px"/>
        <SeekBar android:id="@+id/seek_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView android:id="@+id/lbl_global_dim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:text="global dim R: 0.000"/>
        <SeekBar android:id="@+id/seek_global_dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_zone_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibrate_zone_add"/>
            <Button android:id="@+id/btn_zone_del"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibrate_zone_del"/>
            <Button android:id="@+id/btn_zone_split"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibrate_zone_split"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:text="Severity:"
                android:layout_marginEnd="8dp"/>
            <Button android:id="@+id/btn_tune_severity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibrate_tune_severity"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibrate_save"/>
            <Button android:id="@+id/btn_export"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/calibrate_export"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

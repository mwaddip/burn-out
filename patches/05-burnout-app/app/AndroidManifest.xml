<?xml version="1.0" encoding="utf-8"?>
<!--
  Soong-build manifest for vendor/lineage/burnout/app/. DIFFERENT from
  app/src/main/AndroidManifest.xml — this variant adds sharedUserId so
  the platform-signed system app runs as UID 1000 (system), enabling
  direct file IO on /data/burnout/ without requiring su.

  Keep aligned with app/src/main/AndroidManifest.xml (sync-app-mirror.sh
  excludes this file from rsync). Diff = sharedUserId + sharedUserLabel
  attributes on the <manifest> root tag.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.burnout"
    android:sharedUserId="android.uid.system"
    android:sharedUserLabel="@string/app_name">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BurnoutApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.Burnout"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".LauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".mark.MarkActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".calibrate.CalibrateActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>

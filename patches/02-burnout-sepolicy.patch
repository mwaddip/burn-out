diff --git a/private/burnout_app.te b/private/burnout_app.te
new file mode 100644
index 000000000..1e60261de
--- /dev/null
+++ b/private/burnout_app.te
@@ -0,0 +1,13 @@
+# Burn-out compensation system app — domain stub (Phase 2).
+#
+# This domain type is declared now so the future Burn-out app (Phase 3+)
+# can be associated with it via seapp_contexts without further sepolicy
+# patches needing to land. The seapp_contexts entry that maps the actual
+# `app.burnout` package to this domain is added in Phase 3 along with
+# the rules the app needs (set_prop, /data/burnout file access, etc.).
+#
+# In Phase 2, this declaration is dormant: no app runs in this domain,
+# no rules are attached. SELinux compiles the type into the policy
+# binary but it has no runtime effect.
+
+type burnout_app, domain, coredomain;
